APP_NAME=BilimAI
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-me-with-strong-random-string-min-32-chars
SESSION_COOKIE_NAME=bilimai_session
SESSION_MAX_AGE=604800
DATABASE_URL=sqlite:///./bilimai.db
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-after-first-login
ADMIN_EMAIL=admin@bilimai.local
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60
